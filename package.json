{
    "name": "pydantic-to-typescript-action",
    "version": "3.0.3",
    "description": "GitHub Action to convert Python Pydantic models to TypeScript using LLMs",
    "main": "dist/index.js",
    "scripts": {
        "build": "ncc build src/index.ts -o dist --source-map && mkdir -p dist/prompts && cp prompts/*.txt dist/prompts/",
        "test": "jest",
        "lint": "eslint 'src/**/*.ts'",
        "format": "prettier --write 'src/**/*.ts'",
        "prepare": "husky install"
    },
    "keywords": [
        "github",
        "actions",
        "pydantic",
        "typescript",
        "langchain",
        "llm"
    ],
    "author": "Your Name",
    "license": "MIT",
    "dependencies": {
        "@actions/core": "^1.11.1",
        "@actions/github": "^6.0.1",
        "@langchain/anthropic": "^0.3.34",
        "@langchain/core": "^0.3.80",
        "@langchain/openai": "^0.5.18",
        "diff": "^7.0.0",
        "langchain": "^0.3.37",
        "langsmith": "^0.3.87",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/diff": "^7.0.2",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.20.1",
        "@typescript-eslint/eslint-plugin": "^8.29.0",
        "@typescript-eslint/parser": "^8.29.0",
        "@vercel/ncc": "^0.38.4",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "lint-staged": "^15.5.2",
        "prettier": "^3.9.6",
        "ts-jest": "^29.4.12",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.69.0"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}
